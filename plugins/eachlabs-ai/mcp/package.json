{
  "name": "eachlabs-mcp",
  "version": "0.5.0",
  "description": "Unofficial enhanced MCP server for each::labs models, predictions, audio, workflows, each::sense, and docs.",
  "type": "module",
  "bin": {
    "eachlabs-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "build:debug": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --sourcemap",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "check:versions": "node scripts/check-version-sync.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "update": "npm install && npm run build",
    "check:test": "tsc -p test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
